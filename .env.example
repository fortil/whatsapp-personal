# ============================================================
# whatsapp-personal — variables de entorno
# Copia este archivo a .env y llena los valores.
# Marcadas OBLIGATORIA: la API no arranca sin ellas.
# Las opcionales indican su degradación cuando faltan.
# ============================================================

# ---------- Persistencia (OBLIGATORIAS) ----------
# Postgres local: docker compose up -d postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whatsapp_personal
REDIS_URL=redis://localhost:6379

# ---------- Secretos (OBLIGATORIAS) ----------
# Genera cada una con: openssl rand -hex 32
JWT_SECRET=
WEBHOOK_SECRET=

# ---------- Producción (OBLIGATORIAS en el .env del servidor) ----------
# docker-compose.prod.yml las usa con default silencioso si faltan: dejarlas
# vacías aquí funciona en local, pero en producción hay que llenarlas.
# Dominio desnudo del despliegue (ej. midominio.com); sin ella Caddy sirve
# bajo "localhost" y Let's Encrypt no puede emitir certificado.
DOMAIN=
# Dueño de las imágenes en ghcr.io/<owner>/wp-{api,worker,panel}; sin ella
# el compose de producción cae en "fortil", que no es tu cuenta.
IMAGE_OWNER=
# Contraseña de postgres en producción; sin ella el compose cae en "postgres"
# en silencio. El fallo no se nota hasta que alguien lo explota.
POSTGRES_PASSWORD=

# ---------- Canal WhatsApp (Evolution API) ----------
# Sin EVOLUTION_API_URL o EVOLUTION_API_KEY: las rutas /channel/* responden 503.
# También la usa docker-compose.yml para AUTHENTICATION_API_KEY del contenedor.
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
# URL de la API alcanzable desde el contenedor de Evolution (webhooks).
# En dev con Docker en Mac: http://host.docker.internal:3001
PUBLIC_API_URL=http://host.docker.internal:3001
PANEL_URL=http://localhost:3000

# ---------- LLM / transcripción (modo local) ----------
# local: Ollama en la Mac mini (costo 0). dashscope: nube en prod.
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://<ip-mini>:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
# whisper.cpp en la mini (multipart, mismo contrato que OpenAI)
LOCAL_ASR_BASE_URL=http://<ip-mini>:8081
LOCAL_ASR_MODEL=large-v3-turbo

# ---------- Email (OTP de login y registro) ----------
# console: imprime el código en logs (dev). resend: envía real.
MAILER_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=WhatsApp Personal <no-reply@tudominio.com>

# ---------- SMS (OTP de verificación de teléfono) ----------
# console: imprime el código en logs (dev). twilio: Verify API real.
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------- Opcionales con degradación ----------
# Sin DASHSCOPE_API_KEY: la transcripción cae al siguiente proveedor de la cadena.
DASHSCOPE_API_KEY=
# Sin OPENAI_API_KEY: si tampoco hay ASR local, transcribir da error claro.
OPENAI_API_KEY=
# Sin GOOGLE_*: las rutas /google/* responden 503 (funcionalidad deshabilitada).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# OBLIGATORIA si hay GOOGLE_*: 32 bytes hex (openssl rand -hex 32).
# Cifra los refresh tokens en reposo (AES-256-GCM).
ENCRYPTION_KEY=

# ---------- Varios ----------
# Dónde apunta el panel para llegar a la API (Server Actions, nunca el navegador)
API_URL=http://localhost:3001
# Dónde caen los xlsx exportados (default ./var/exports, gitignored)
EXPORT_DIR=./var/exports
# Seed del superadmin (pnpm db:seed). Celular CO en cualquier formato aceptado.
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+573001234567
ADMIN_PASSWORD=
API_PORT=3001
# Liveness del worker (GET /health). El servicio worker del compose (con su
# propio healthcheck) llega en la Fase 7; hoy el worker corre por `pnpm dev`.
WORKER_PORT=3002
# Cada cuánto corre el reaper del worker (ms). Marca 'error' las
# transcripciones 'pending' colgadas más de 10 minutos.
REAPER_INTERVAL_MS=60000
